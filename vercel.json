{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"buildCommand": "SPORT=basketball pnpm run build",
	"outputDirectory": "build",
	"installCommand": "PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1 pnpm install --frozen-lockfile",
	"framework": null,
	"rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
}
